# 이 파일을 복사해서 같은 폴더에 ".env.local" 로 저장하고 값을 채우세요.
#   cp .env.local.example .env.local   (Windows: copy)
# .env.local 은 git 에 올라가지 않습니다(자격증명 보호).

# ── 이카운트 OAPI (필수) ──
ECOUNT_COM_CODE=
ECOUNT_USER_ID=
ECOUNT_API_CERT_KEY=
# ECOUNT_ZONE=CA          # (선택) 미설정 시 자동조회
# ECOUNT_TEST=false       # (선택) 테스트(sbo) 서버면 true
# ECOUNT_MAP_OPTION=SIZE_DES   # (선택) 규격 필드명을 직접 지정 (--diag 로 확인한 필드명)

# ── 배포된 카탈로그로 밀어넣기 (필수) ──
CATALOG_PUSH_URL=https://work-manager-liart.vercel.app/api/catalog
CRON_SECRET=
