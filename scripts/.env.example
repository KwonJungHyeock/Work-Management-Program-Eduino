# 엔티렉스(디바이스마트) 크롤러 설정
# ── 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사해서 사용하세요 ──
#    (윈도우 탐색기에서 이름을 ".env." 로 입력하면 만들어집니다)

# 수집 결과를 올릴 앱 저장 API. 아래 값 그대로 사용.
STORE_URL=https://work-manager-liart.vercel.app/api/store

# 전 품목을 3일에 나눠 순환 조회(권장). 매일 실행해도 하루 부담·차단위험을 낮춤.
NTREX_CYCLE_DAYS=3

# 요청 간 기본 간격(ms). 실제 간격은 0.9~1.8배 랜덤. 기본 5000 권장.
NTREX_DELAY_MS=5000

# (선택) IP 가 차단될 때만 국내 프록시 사용. 예) http://아이디:비번@프록시호스트:포트
# NTREX_PROXY=
