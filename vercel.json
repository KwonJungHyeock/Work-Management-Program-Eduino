{
  "crons": [
    { "path": "/api/cron-sync", "schedule": "0 15 * * *" },
    { "path": "/api/backup-snapshot", "schedule": "10 15 1 * *" },
    { "path": "/api/mouser-cron", "schedule": "0 22 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
